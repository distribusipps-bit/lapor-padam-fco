    return '<div class="preview"><img alt="Foto fuse link" src="'+d.foto+'"><div class="meta">Foto siap dikirim.<br><button type="button" class="link" id="photoDel">Hapus foto</button></div></div>';
  }
  return '<button type="button" class="photoBtn" id="photoBtn"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>Ambil foto</button>';
}

function resolve(k){
  var f=FIELD[k],o=(d.other[k]||"").trim();
  var map=function(v){return v==="__other"?"Lainnya: "+o:v};
  return f.type==="multi"?d[k].map(map):map(d[k]);
}

function validate(){
  var errs={};
  if(!d.tanggal||!d.jam)errs.waktuPadam="Isi tanggal dan jam padam.";
  FIELDS.forEach(function(f){
    var k=f.k,v=d[k];
    if(f.type==="single"){
      if(!v)errs[k]="Pilih salah satu.";
      else if(v==="__other"&&!(d.other[k]||"").trim())errs[k]="Tulis isian lainnya.";
    }else if(f.type==="multi"){
      if(!v.length)errs[k]="Pilih minimal satu.";
      else if(v.indexOf("__other")>=0&&!(d.other[k]||"").trim())errs[k]="Tulis isian lainnya.";
    }else if(k==="fco"){
      if(!v)errs[k]=d.penyulang?"Pilih FCO yang padam.":"Pilih penyulang lebih dulu.";
      else if(v==="__other"&&!(d.other[k]||"").trim())errs[k]="Tulis nama FCO.";
    }else if(k==="foto"){
      if(!v)errs[k]="Foto fuse link wajib dilampirkan.";
    }
  });
  return errs;
}
function showErrors(errs){
  var first=null;
  $$("[data-field]").forEach(function(s){
    var k=s.dataset.field,m=errs[k],p=$(".err-msg",s);
    s.classList.toggle("err",!!m);
    if(p){p.hidden=!m;p.textContent=m||""}
    if(m&&!first)first=s;
  });
  if(first)first.scrollIntoView({behavior:"smooth",block:"center"});
}

function buildRecord(){
  var id=uuid();
  return{
    id:id,ts:new Date().toISOString(),regu:regu,
    tanggal:d.tanggal,jam:d.jam,
    penyulang:resolve("penyulang"),zona:resolve("zona"),fco:resolve("fco"),
    penyebab:resolve("penyebab"),fasa:resolve("fasa"),waktu:resolve("waktu"),
    ukPutus:resolve("ukPutus"),ukPasang:resolve("ukPasang"),
    foto:d.foto,synced:false
  };
}

var lastRec=null;
function renderDone(){
  var r=lastRec;
  var rows=[["Regu",r.regu,"m"],["Padam",shortDate(r.tanggal)+" · "+r.jam,"m"],["Penyulang",r.penyulang+" · "+r.zona,"m"],["FCO",r.fco,"m"],
    ["Penyebab",r.penyebab.join(", ")],["Fasa putus",r.fasa.join(", "),"m"],["Fuse link",r.ukPutus+" → "+r.ukPasang,"m"]];
  var live=reports.filter(function(x){return x.id===r.id})[0];
  var synced=live&&live.synced;
  viewEl.innerHTML='<section class="card done"><div class="tick"><svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>'+
    '<h2>Laporan tersimpan</h2><p>Terima kasih sudah melapor padam FCO.</p>'+
    '<span class="pill '+(synced?"ok":"wait")+'" id="syncPill">'+(synced?"Sudah terkirim ke rekap":"Tersimpan di HP, belum terkirim")+'</span>'+
    '<dl class="kv">'+rows.map(function(x){return '<dt>'+x[0]+'</dt><dd class="'+(x[2]||"")+'">'+esc(x[1])+'</dd>'}).join("")+'</dl>'+
    '<button class="btn" id="nextBtn" type="button">Laporan berikutnya</button></section>';
}

/* ---------- Riwayat ---------- */
function allReports(){
  var map={},out=[];
  remote.forEach(function(r){map[r.id]=1;out.push(Object.assign({},r,{synced:true}))});
  reports.forEach(function(r){if(!map[r.id])out.push(r)});
  out.sort(function(a,b){return a.ts<b.ts?1:-1});
  return out;
}
function renderRiwayat(){
  var all=allReports();
  var list=scope==="regu"?all.filter(function(r){return r.regu===regu}):all;
  var t=today();
  var hari=list.filter(function(r){return r.tanggal===t}).length;
  var pend=reports.filter(function(r){return !r.synced}).length;
  var h='<div class="stats"><div class="stat"><b>'+hari+'</b><span>laporan hari ini</span></div>'+
        '<div class="stat"><b>'+list.length+'</b><span>total '+(scope==="regu"?"regu ini":"semua regu")+'</span></div>'+
        '<div class="stat"><b>'+pend+'</b><span>belum terkirim</span></div></div>';
  h+='<div class="seg"><button type="button" class="btn ghost sm" id="csvBtn" style="margin-left:auto"'+(list.length?"":" disabled")+'>Ekspor CSV</button></div>';
  h+='<p class="note">Daftar ini hanya laporan dari HP ini. Rekap semua regu ada di Google Sheets.</p>';
  h+='<div id="csvOut"></div>';
  if(!list.length){
    h+='<div class="empty"><b>Belum ada laporan</b>Laporan yang dikirim '+(scope==="regu"?"regu ini":"semua regu")+' akan muncul di sini.</div>';
  }else{
    h+=list.slice(0,100).map(function(r){
      var thumb=r.foto?'<img class="thumb" alt="Foto fuse link" src="'+r.foto+'">':"";
      return '<article class="rep"><h4>'+esc(r.penyulang)+' · '+esc(r.zona)+'<span>'+esc(/^\d+$/.test(r.fco)?'FCO '+r.fco:r.fco)+'</span></h4>'+thumb+
        '<p>'+esc(shortDate(r.tanggal))+' '+esc(r.jam)+' · '+esc(r.waktu)+' · '+esc(r.regu)+'</p>'+
        '<div class="tags">'+
          '<span class="pill">Fasa '+esc((r.fasa||[]).join(" "))+'</span>'+
          '<span class="pill">'+esc(r.ukPutus)+' → '+esc(r.ukPasang)+'</span>'+
          (r.penyebab||[]).map(function(p){return '<span class="pill">'+esc(p)+'</span>'}).join("")+
          '<span class="pill '+(r.synced?"ok":"wait")+'">'+(r.synced?"Terkirim":"Belum terkirim")+'</span>'+
        '</div></article>';
    }).join("");
  }
  viewEl.innerHTML=h;
}

/* ---------- CSV ---------- */
function csvOf(list){
  var head=["Timestamp","Tanggal Padam","Jam Padam","Nama Regu","Penyulang","Zona","FCO","Penyebab Gangguan","Fasa Putus","Waktu Padam","Ukuran Fuselink Putus","Ukuran Fuselink Terpasang","Foto"];
  var q=function(s){return '"'+String(s==null?"":s).replace(/"/g,'""')+'"'};
  var rows=list.map(function(r){return [r.ts,r.tanggal,r.jam,r.regu,r.penyulang,r.zona,r.fco,(r.penyebab||[]).join("; "),(r.fasa||[]).join("; "),r.waktu,r.ukPutus,r.ukPasang,r.foto?"ada":"tidak ada"].map(q).join(",")});
  return "﻿"+[head.map(q).join(",")].concat(rows).join("\r\n");
}
async function exportCSV(){
  var all=allReports();
  var list=scope==="regu"?all.filter(function(r){return r.regu===regu}):all;
  if(!list.length)return;
  var csv=csvOf(list);
  var name="rekap-padam-fco-"+today()+".csv";
  try{var a=document.createElement("a");a.href=URL.createObjectURL(new Blob([csv],{type:"text/csv;charset=utf-8"}));a.download=name;document.body.appendChild(a);a.click();a.remove();toast("CSV diunduh");return}catch(e){}
  try{await navigator.clipboard.writeText(csv);toast("CSV disalin. Tempel ke Google Sheets.");return}catch(e){}
  var box=$("#csvOut");
  box.innerHTML='<p class="note">Salin teks di bawah, lalu tempel ke Google Sheets.</p><textarea class="csvbox" id="csvText" readonly></textarea>';
  var ta=$("#csvText");ta.value=csv;ta.focus();ta.select();
}

/* ---------- Photo ---------- */
function compress(file){
  return new Promise(function(resolve,reject){
    var url=URL.createObjectURL(file),img=new Image();
    img.onload=function(){
      var max=720,s=Math.min(1,max/Math.max(img.width,img.height));
      var c=document.createElement("canvas");c.width=Math.round(img.width*s);c.height=Math.round(img.height*s);
      c.getContext("2d").drawImage(img,0,0,c.width,c.height);
      URL.revokeObjectURL(url);
      var q=.7,out=c.toDataURL("image/jpeg",q);
      while(out.length>170000&&q>.35){q-=.1;out=c.toDataURL("image/jpeg",q)}
      resolve(out);
    };
    img.onerror=function(){URL.revokeObjectURL(url);reject(new Error("img"))};
    img.src=url;
  });
}

/* ---------- Simpan dan kirim ---------- */
function persist(){
  var slim=reports.slice(0,150);
  if(store.set("lpf.reports",slim))return;
  slim=slim.map(function(r){return r.synced?Object.assign({},r,{foto:null}):r});
  if(store.set("lpf.reports",slim))return;
  slim=slim.map(function(r){return Object.assign({},r,{foto:null})});
  store.set("lpf.reports",slim);
}
function uuid(){
  if(window.crypto&&crypto.randomUUID)return crypto.randomUUID();
  return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g,function(c){var r=Math.random()*16|0;return (c==="x"?r:(r&3|8)).toString(16)});
}
async function push(r){
  if(!sb)return false;
  try{
    var url=r.fotoUrl||null;
    if(!url&&r.foto){
      var blob=await (await fetch(r.foto)).blob();
      var path=r.tanggal+"/"+r.id+".jpg";
      var up=await sb.storage.from(CFG.BUCKET||"foto-fuse-link").upload(path,blob,{contentType:"image/jpeg",upsert:false});
      if(up.error&&!/exist|duplicate/i.test(up.error.message||""))return false;
      url=sb.storage.from(CFG.BUCKET||"foto-fuse-link").getPublicUrl(path).data.publicUrl;
      r.fotoUrl=url;
    }
    var res=await sb.from("laporan").insert({
      id:r.id,dibuat_pada:r.ts,tanggal:r.tanggal,jam:r.jam,regu:r.regu,
      penyulang:r.penyulang,zona:r.zona,fco:r.fco,penyebab:r.penyebab,fasa:r.fasa,
      waktu:r.waktu,ukuran_putus:r.ukPutus,ukuran_terpasang:r.ukPasang,foto_url:url
    });
    if(res.error){return res.error.code==="23505"}
    return true;
  }catch(e){return false}
}
var flushing=false;
async function flush(){
  if(flushing||!sb)return;
  flushing=true;
  try{
    var pending=reports.filter(function(r){return !r.synced});
    for(var i=0;i<pending.length;i++){
      var ok=await push(pending[i]);
      if(!ok)break;
      pending[i].synced=true;pending[i].foto=null;
    }
    persist();
  }finally{flushing=false}
  if(view==="riwayat")renderRiwayat();
  if(view==="done"){var p=$("#syncPill"),live=reports.filter(function(x){return lastRec&&x.id===lastRec.id})[0];if(p&&live&&live.synced){p.className="pill ok";p.textContent="Sudah terkirim ke rekap"}}
}

async function submit(){
  var errs=validate();
  showErrors(errs);
  if(Object.keys(errs).length){toast("Lengkapi isian yang ditandai.");return}
  var btn=$("#submitBtn");btn.disabled=true;btn.textContent="Menyimpan…";
  var rec=buildRecord();
  reports.unshift(rec);persist();
  lastRec=rec;
  view="done";render();window.scrollTo(0,0);
  flush();
}

/* ---------- Toast ---------- */
var toastT=null;
function toast(m){var t=$("#toast");t.textContent=m;t.hidden=false;clearTimeout(toastT);toastT=setTimeout(function(){t.hidden=true},2600)}

/* ---------- Events ---------- */
function go(name){
  if(name==="riwayat"){view="riwayat";try{location.hash="riwayat"}catch(e){}}
  else if(name==="atur"){setupSel=regu;setupOther="";view="setup";try{location.hash="atur"}catch(e){}}
  else{view="lapor";try{location.hash="lapor"}catch(e){}}
  render();window.scrollTo(0,0);
}
function syncGroup(k){
  var sec=$('[data-field="'+k+'"]');if(!sec)return;
  var f=FIELD[k];
  $$(".chip",sec).forEach(function(c){
    var v=c.dataset.v;
    var on=f.type==="single"?d[k]===v:d[k].indexOf(v)>=0;
    c.setAttribute("aria-pressed",on?"true":"false");
  });
  var other=$("#o-"+k);
  if(other){
    var on=f.type==="single"?d[k]==="__other":d[k].indexOf("__other")>=0;
    other.hidden=!on;if(on)other.focus();
  }
  sec.classList.remove("err");var p=$(".err-msg",sec);if(p)p.hidden=true;
}

function fcoOptions(){
  var list=FCO_BY[d.penyulang]||[];
  var h='<option value="">'+(d.penyulang?"Pilih FCO":"Pilih penyulang lebih dulu")+'</option>';
  list.forEach(function(n){h+='<option value="'+esc(n)+'"'+(d.fco===n?" selected":"")+'>'+esc(n)+'</option>'});
  h+='<option value="__other"'+(d.fco==="__other"?" selected":"")+'>ISI NAMA FCO GARDU</option>';
  return h;
}
function refreshFco(){
  var list=FCO_BY[d.penyulang]||[];
  if(d.fco&&d.fco!=="__other"&&list.indexOf(d.fco)<0)d.fco="";
  var sel=$("#f-fco");if(!sel)return;
  sel.innerHTML=fcoOptions();sel.disabled=!d.penyulang;
  var o=$("#o-fco");if(o)o.hidden=d.fco!=="__other";
  var n=$("#fcoCount");
  if(n)n.textContent=(d.penyulang&&d.penyulang!=="__other")?(list.length+" FCO terdaftar di "+d.penyulang):"Pilih penyulang untuk melihat daftar FCO-nya.";
  var s=$('[data-field="fco"]');if(s){s.classList.remove("err");var m=$(".err-msg",s);if(m)m.hidden=true}
}
viewEl.addEventListener("click",function(e){
  var t=e.target;
  var c=t.closest&&t.closest(".chip");
  if(c&&c.dataset.scope){scope=c.dataset.scope;renderRiwayat();return}
  if(c&&c.dataset.k==="regu"){
    setupSel=(setupSel===c.dataset.v)?"":c.dataset.v;
    $$("#setupChips .chip").forEach(function(b){b.setAttribute("aria-pressed",b.dataset.v===setupSel?"true":"false")});
    var o=$("#o-regu");o.hidden=setupSel!=="__other";if(!o.hidden)o.focus();
    $("#setupErr").hidden=true;return;
  }
  if(c&&c.dataset.k){
    var k=c.dataset.k,v=c.dataset.v,f=FIELD[k];
    if(f.type==="single"){d[k]=d[k]===v?"":v;if(k==="waktu")d.waktuAuto=false}
    else{var i=d[k].indexOf(v);if(i>=0)d[k].splice(i,1);else d[k].push(v)}
    syncGroup(k);if(k==="penyulang")refreshFco();return;
  }
  var b=t.closest&&t.closest("button");if(!b)return;
  if(b.id==="setupSave"){
    var name=setupSel==="__other"?(setupOther||"").trim().toUpperCase():setupSel;
    if(!name){var er=$("#setupErr");er.hidden=false;er.textContent=setupSel==="__other"?"Tulis nama regu.":"Pilih regu lebih dulu.";return}
    regu=name;store.set("lpf.regu",regu);go("lapor");toast("HP ini diatur untuk regu "+regu);
  }else if(b.id==="submitBtn")submit();
  else if(b.id==="photoBtn")$("#f-foto").click();
  else if(b.id==="photoDel"){d.foto=null;$("#photoBox").innerHTML=photoHTML()}
  else if(b.id==="nextBtn"){d=blank();go("lapor")}
  else if(b.id==="csvBtn")exportCSV();
});
viewEl.addEventListener("input",function(e){
  var t=e.target;
  if(t.id==="f-tanggal")d.tanggal=t.value;
  else if(t.id==="f-jam"){
    d.jam=t.value;
    if(d.waktuAuto&&t.value){d.waktu=bucket(t.value);syncGroup("waktu")}
  }
  else if(t.id==="o-regu")setupOther=t.value;
  else if(t.id&&t.id.indexOf("o-")===0)d.other[t.id.slice(2)]=t.value;
});
viewEl.addEventListener("change",async function(e){
  var t=e.target;
  if(t.id==="f-fco"){
    d.fco=t.value;var o=$("#o-fco");o.hidden=d.fco!=="__other";if(!o.hidden)o.focus();
    var s=$('[data-field="fco"]');s.classList.remove("err");$(".err-msg",s).hidden=true;return;
  }
  if(t.id==="f-foto"&&t.files&&t.files[0]){
    try{d.foto=await compress(t.files[0]);$("#photoBox").innerHTML=photoHTML();
      var s=$('[data-field="foto"]');s.classList.remove("err");$(".err-msg",s).hidden=true}
    catch(err){toast("Foto tidak bisa dibaca. Coba ambil ulang.")}
  }
});
$("#tabs").addEventListener("click",function(e){var b=e.target.closest("button");if(b)go(b.dataset.go)});
$("#reguBtn").addEventListener("click",function(){go("atur")});
window.addEventListener("hashchange",function(){
  if(!regu)return;
  var h=location.hash.replace("#","");
  if(h==="riwayat"&&view!=="riwayat"){view="riwayat";render()}
  else if(h==="lapor"&&view!=="lapor"&&view!=="done"){view="lapor";render()}
});

/* ---------- Start ---------- */
(function init(){
  var h="";try{h=location.hash.replace("#","")}catch(e){}
  if(regu&&h==="riwayat")view="riwayat";
  render();
  initSupabase();
})();

function initSupabase(){
  if(!CFG.SUPABASE_URL||!CFG.SUPABASE_ANON_KEY||!window.supabase)return;
  sb=window.supabase.createClient(CFG.SUPABASE_URL,CFG.SUPABASE_ANON_KEY,{auth:{persistSession:false,autoRefreshToken:false}});
  flush();
  window.addEventListener("online",flush);
  document.addEventListener("visibilitychange",function(){if(!document.hidden)flush()});
}
})();
</script>
</body>
